{
  "manifest_version": 3,
  "name": "Focus — Site Tracker",
  "version": "0.4.1",
  "description": "Stay focused and keep distracting sites in check. A local companion for Focus on Omarchy Linux.",
  "permissions": [
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "site-metadata.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "status.html",
    "default_title": "Focus",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
